{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Rejects by station",
  "data": {
    "url": {
      "index": "capsule_units",
      "body": {
        "size": 0,
        "track_total_hits": true,
        "query": {
          "bool": {
            "filter": [
              {
                "term": {
                  "produced": true
                }
              },
              {
                "term": {
                  "result": "FAIL"
                }
              },
              "%dashboard_context-filter_clause%",
              {
                "range": {
                  "event_time": {
                    "gte": {
                      "%timefilter%": "min"
                    },
                    "lt": {
                      "%timefilter%": "max"
                    }
                  }
                }
              }
            ],
            "must": [
              "%dashboard_context-must_clause%"
            ],
            "must_not": [
              "%dashboard_context-must_not_clause%"
            ]
          }
        },
        "aggs": {
          "reasons": {
            "terms": {
              "field": "reject_reason",
              "missing": "UNKNOWN_REASON",
              "size": 6,
              "order": [
                {
                  "_count": "desc"
                },
                {
                  "_key": "asc"
                }
              ]
            }
          },
          "stations": {
            "terms": {
              "field": "reject_station_id",
              "missing": "UNKNOWN_STATION",
              "size": 5,
              "order": [
                {
                  "_count": "desc"
                },
                {
                  "_key": "asc"
                }
              ]
            }
          }
        }
      }
    },
    "format": {
      "property": "aggregations.stations.buckets"
    }
  },
  "encoding": {
    "y": {
      "field": "doc_count",
      "type": "quantitative",
      "title": "Rejected capsules"
    },
    "tooltip": [
      {
        "field": "key",
        "title": "Code"
      },
      {
        "field": "doc_count",
        "title": "Capsules"
      }
    ],
    "x": {
      "field": "key",
      "type": "nominal",
      "sort": null,
      "title": null,
      "axis": {
        "labelAngle": -35,
        "labelLimit": 180
      }
    }
  },
  "mark": "bar",
  "width": 420,
  "height": 220
}
